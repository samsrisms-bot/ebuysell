DATABASE_URL="postgresql://crmapp:CHANGE_ME@localhost:5432/crm_backend"
PORT=8080

# Sent by the SIM IVR Android app (Settings > CRM integration) as both
# "Authorization: Bearer <key>" and "X-Api-Key: <key>".
API_KEY=CHANGE_ME_APP_KEY

# Separate token that protects the human-facing dashboard + admin API (/api/campaigns,
# /api/leads, /api/events). Never reuse API_KEY here.
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN

NODE_ENV=production
LOG_LEVEL=info
